datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  createdAt     DateTime  @default(now())
  files         StudyMaterial[]
  progress      UserProgress[]
  attempts      PracticeAttempt[]
}

model StudyMaterial {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  fileName        String
  fileType        String
  fileSize        Int
  uploadDate      DateTime @default(now())
  subject         String?
  topic           String?
  processingStatus String   @default("queued")
  storageLocation String
  extractedText   ExtractedText[]
  questions       PracticeQuestion[]
}

model ExtractedText {
  id            String         @id @default(cuid())
  documentId    String
  document      StudyMaterial  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber    Int?
  section       String?
  content       String
  embedding     String?
}

model PracticeQuestion {
  id          String         @id @default(cuid())
  documentId  String
  document    StudyMaterial  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  topic       String?
  question    String
  options     String
  answer      String
  explanation String
  difficulty  String?
  attempts    PracticeAttempt[]
}

model PracticeAttempt {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String
  correct    Boolean
  answeredAt DateTime         @default(now())

  @@index([userId])
  @@index([questionId])
}

model UserProgress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic         String
  mastery       Float    @default(0)
  totalAnswered Int      @default(0)
  totalCorrect  Int      @default(0)
  lastUpdated   DateTime @default(now())

  @@unique([userId, topic])
  @@index([userId])
}
